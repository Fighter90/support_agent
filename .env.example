# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.
ENVIRONMENT=production
PUBLIC_URL=https://methodagent.ru

# GigaChat (основная модель): Authorization key из личного кабинета developers.sber.ru
LLM_PROVIDER=gigachat
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_B2B
GIGACHAT_MODEL=GigaChat-2-Max

# YandexGPT (резервная модель): API-ключ сервисного аккаунта с ролью ai.languageModels.user
LLM_FALLBACK_PROVIDER=yandex
YANDEX_API_KEY=
YANDEX_FOLDER_ID=b1gh8uv9d9ur7e4kmvvi
YANDEX_MODEL=yandexgpt-5.1

# Кабинет менеджера (смените пароли перед показом)
SECRET_KEY=
MANAGER_LOGIN=manager
MANAGER_PASSWORD=
JURY_LOGIN=jury
JURY_PASSWORD=

# Оплата: токен MCP-сервера ЮKassa (Интеграция → Доступы к магазину → Токены для MCP-сервера); пусто — демо-режим
YOOKASSA_MCP_TOKEN=
# Необязательно: субаккаунт (заголовок Mcp-Param-Gateway-Id)
YOOKASSA_GATEWAY_ID=

# Telegram-бот менеджера (токен от @BotFather); пусто — бот выключен
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=SoftlineSupportBot

# --- Модель с открытыми весами (путь внедрения в контур Softline; диалог по ссылке /?model=open)
# Свой сервер: vLLM/Ollama, например OPENWEIGHTS_BASE_URL=http://vllm.internal:8000/v1, OPENWEIGHTS_MODEL=Qwen/Qwen3.6-35B-A3B
# Стенд: та же Qwen3.6-35B-A3B (Apache 2.0) в Yandex AI Studio:
OPENWEIGHTS_BASE_URL=
OPENWEIGHTS_AUTH=Api-Key
OPENWEIGHTS_API_KEY=
OPENWEIGHTS_PROJECT=
OPENWEIGHTS_MODEL=
OPENWEIGHTS_PRICE_PER_1K=0.20
OPENWEIGHTS_PRICE_OUT_PER_1K=0.30
